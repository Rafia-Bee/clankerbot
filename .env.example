# ---- Discord bot ----
# The bot's login token. Developer Portal -> your application -> Bot -> Reset Token. Keep this secret.
BOT_TOKEN=
# The bot's application ID. Developer Portal -> General Information -> Application ID. Used by deploy-commands.js.
CLIENT_ID=
# Your server's ID (right-click the server icon -> Copy Server ID). deploy-commands.js registers the commands here.
GUILD_ID=
