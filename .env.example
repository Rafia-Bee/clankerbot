# ---- Discord bot ----
# The bot's login token. Developer Portal -> your application -> Bot -> Reset Token. Keep this secret.
BOT_TOKEN=
# The bot's application ID. Developer Portal -> General Information -> Application ID. Used by deploy-commands.js.
CLIENT_ID=
# Your server's ID (right-click the server icon -> Copy Server ID). deploy-commands.js registers the commands here.
GUILD_ID=

# ---- Character lookups (/whois) ----
# Everything below has a sensible default, so only AION2INDEX_API_KEY needs filling in. Leave the rest as they are
# unless you want to change how lookups work.

# API key from the aion2index community panel (https://aion2index.com/communities/docs). Keep it secret.
# Clanker can share orcabot's key. The key allows 60 lookups a minute in total, so keep the two bots' gaps
# (AION2INDEX_MIN_REQUEST_GAP_MS here and in orcabot) adding up to less than that.
AION2INDEX_API_KEY=
# Which sites to look characters up on, in order: the first is used, the next only when it fails.
# aion2index, shugo, or both. Example: aion2index,shugo (aion2index first, shugo.gg as backup).
LOOKUP_SOURCES=aion2index,shugo
# After a site fails, use the next one first for this many minutes before trying it again.
LOOKUP_FAILOVER_MINUTES=5
# The game server's name, as shown in "No character called X on <server>". Keep the region paths below in sync.
LOOKUP_SERVER_NAME=Israphel
# Longest name /whois accepts. Longer names are turned away without asking any site.
MAX_CHARACTER_NAME_LENGTH=32
# How the bot introduces itself to the lookup sites on each request.
LOOKUP_USER_AGENT="Clanker/1.0 (Discord character lookup)"
# Give up on a site after this many milliseconds and try the next one.
LOOKUP_REQUEST_TIMEOUT_MS=15000
# How long (milliseconds) an answer is reused before the sites are asked again for the same name.
LOOKUP_CACHE_TTL_MS=60000

# aion2index API address and the <region>/<server> part for Israphel.
AION2INDEX_BASE_URL=https://aion2index.com/api/v1/characters
AION2INDEX_REGION_PATH=eu/israphel
# Minimum milliseconds between two aion2index lookups. 4000 is 15 a minute, which leaves orcabot (1500, 40 a minute)
# room on the shared key.
AION2INDEX_MIN_REQUEST_GAP_MS=4000

# shugo.gg character page address and the region/server part for Israphel.
SHUGO_BASE_URL=https://shugo.gg/character
SHUGO_REGION_PATH=global/eu-israphel
# Minimum milliseconds between two shugo.gg lookups. shugo.gg allows about one every 2000 ms.
SHUGO_MIN_REQUEST_GAP_MS=3000
